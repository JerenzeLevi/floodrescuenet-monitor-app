<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_light" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/admin_title" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/indigo" />
        <TextView android:id="@+id/tvAdminScope" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="@color/text_secondary" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/admin_pending_header" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary" />
        <TextView android:id="@+id/tvEmptyPending" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/admin_no_pending" android:textSize="13sp" android:textColor="@color/text_secondary" android:visibility="gone" />
        <LinearLayout android:id="@+id/pendingContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp" />

        <LinearLayout android:id="@+id/promoteSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/admin_promote_header" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary" />
            <TextView android:id="@+id/tvEmptyPromote" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/admin_no_promotable" android:textSize="13sp" android:textColor="@color/text_secondary" android:visibility="gone" />
            <LinearLayout android:id="@+id/promoteContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnGoDashboard" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="24dp" android:text="@string/admin_go_to_dashboard" app:cornerRadius="12dp" app:backgroundTint="@color/indigo" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
