<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/indigo" app:strokeWidth="1.5dp" app:cardBackgroundColor="@android:color/white">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:background="@color/red_danger_bg" android:paddingVertical="20dp">
            <ImageView android:layout_width="56dp" android:layout_height="56dp" android:padding="14dp" android:background="@drawable/bg_status_pill_indigo" android:src="@drawable/ic_warning" app:tint="@android:color/white" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="CONFIRM DEPLOYMENT" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_primary" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:paddingHorizontal="20dp" android:gravity="center" android:text="Manual Net Deployment Request" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" />
        <TextView android:id="@+id/tvConfirmLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingTop="6dp" android:gravity="center" android:text="the demo net" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingTop="4dp" android:paddingBottom="16dp" android:gravity="center" android:text="Warning: this sends one deploy request to your demo session; the result appears after acknowledgement. Ensure all personnel are clear." android:textSize="13sp" android:textColor="@color/text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/surface_light" android:padding="16dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnConfirmCancel" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cancel" android:textColor="@color/text_primary" app:strokeColor="@color/card_border" app:cornerRadius="10dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnConfirmDeploy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="DEPLOY NOW" android:textStyle="bold" app:backgroundTint="@color/red_danger" app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
