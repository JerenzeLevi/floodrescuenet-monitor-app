            "$other": {
              ".validate": false
            }
          }
        },
        "deployments": {
          ".indexOn": [
            "timestamp"
          ],
          "$id": {
            ".write": "(auth != null && root.child('deviceLinks').child($uid).val() == auth.uid) && newData.exists()",
            ".validate": "newData.hasChildren([\"timestamp\", \"location\", \"initiator\", \"status\"])",
            "timestamp": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 5000"
            },
            "location": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "initiator": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "status": {
              ".validate": "newData.val() == 'Success' || newData.val() == 'Failed' || newData.val() == 'Pending'"
            },
            "cycleMs": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60000"
            },
            "error": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "$other": {
              ".validate": false
            },
            "unitId": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "thrustPercent": {
              ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 100"
            }
          }
        },
        "contacts": {
          "$id": {
            ".write": "(auth != null && root.child('deviceLinks').child($uid).val() == auth.uid) && newData.exists()",
            ".validate": "newData.hasChildren(['name','number'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "subtitle": {
              ".validate": "newData.isString() && newData.val().length <= 160"
            },
            "number": {
              ".validate": "newData.isString() && newData.val().matches(/^[+0-9() -]{3,25}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "diagnostic": {
          ".write": "(auth != null && root.child('deviceLinks').child($uid).val() == auth.uid) && newData.exists()",
          ".validate": "newData.hasChildren([\"timestamp\", \"severity\", \"title\", \"description\", \"category\"])",
          "timestamp": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 5000"
          },
          "severity": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "description": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "category": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "type": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "$other": {
            ".validate": false
          },
          "resolution": {
            ".validate": "newData.val() == 'Resolved' || newData.val() == 'Passed' || newData.val() == 'Pending'"
          }
        },
        "archive": {
          "events": {
            ".indexOn": [
              "timestamp"
            ]
          },
          "readings": {
            ".indexOn": [
              "timestamp"
            ]
          },
          "deployments": {
            ".indexOn": [
              "timestamp"
            ]
          }
        },
        "archiveStatus": {
          ".write": false
        }
      }
    },
    "deviceLinks": {
      "$uid": {
        ".read": "(auth != null && auth.uid == $uid && root.child('users').child($uid).child('verified').val() == true) || (auth != null && root.child('deviceLinks').child($uid).val() == auth.uid)",
        ".write": false,
        ".validate": "newData.isString()"
      }
    }
  }
}
